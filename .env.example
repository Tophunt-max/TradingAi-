# Copy to .env for local development. Never commit .env.
# Backend (FastAPI)
ENVIRONMENT=development            # development | test | staging | paper | production
DEBUG=false
DATABASE_URL=postgresql+psycopg://quantai:quantai_dev_only@localhost:5432/quantai
REDIS_URL=redis://localhost:6379/0
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-long-random-value
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
CORS_ORIGINS=http://localhost:8081,http://localhost:19006
# console = print codes to server log (development only). No real provider yet.
OTP_DELIVERY=console
# DEMO = synthetic, clearly labelled data. DISABLED = market endpoints return 503.
MARKET_DATA_MODE=DEMO
PAPER_TRADING_ENABLED=true
# Must stay false. The app refuses to start if set to true in this build.
LIVE_TRADING_ENABLED=false

# Mobile (Expo). Only public, non-secret values may use the EXPO_PUBLIC_ prefix.
EXPO_PUBLIC_API_URL=http://localhost:8000
