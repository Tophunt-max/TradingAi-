# Copy to .env for local development. Never commit .env.
# Backend (FastAPI)
ENVIRONMENT=development            # development | test | staging | paper | production
DEBUG=false
DATABASE_URL=postgresql+psycopg://quantai:quantai_dev_only@localhost:5432/quantai
REDIS_URL=redis://localhost:6379/0
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-long-random-value
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
CORS_ORIGINS=http://localhost:8081,http://localhost:19006
# console = print codes to server log (development only). No real provider yet.
OTP_DELIVERY=console
# DEMO = synthetic, clearly labelled data. INDSTOCKS = INDmoney INDstocks API.
# DISABLED = market endpoints return 503.
MARKET_DATA_MODE=DEMO

# INDstocks (only when MARKET_DATA_MODE=INDSTOCKS). Server-side only, never in the app.
# Generate the token at https://www.indstocks.com/app/api-trading/access-tokens (valid 24h).
INDSTOCKS_ACCESS_TOKEN=
# The data comes from your own brokerage login: only these app users may see it.
INDSTOCKS_DATA_USER_EMAILS=you@example.com
# Optional, verify first: REST quote codes for indices, e.g. NIFTY=NSE_xxx,BANKNIFTY=NSE_yyy
INDSTOCKS_INDEX_QUOTE_CODES=
STALE_QUOTE_SECONDS=60
# Official NSE holiday list for the year (YYYY-MM-DD, comma-separated). Not bundled.
MARKET_HOLIDAYS=
PAPER_TRADING_ENABLED=true
# Paper simulator (see docs/risk.md). Brokerage per executed order, in rupees.
PAPER_BROKERAGE_PER_ORDER=20
PAPER_SLIPPAGE_TICKS=1
# Market BUY refused when (ask - bid) / ltp is wider than this percentage.
PAPER_MAX_SPREAD_PCT=5
# 0 = fill at once; N = at most N units per pass (simulates partial fills).
PAPER_MAX_FILL_QTY_PER_PASS=0
# DEMO data only: the DEMO market never closes. false = apply session rules to DEMO too.
DEMO_MARKET_ALWAYS_OPEN=true
# Development only: run the bot worker inside the API process.
BOT_WORKER_EMBEDDED=false
BOT_WORKER_INTERVAL_SECONDS=15
# Must stay false. The app refuses to start if set to true in this build.
LIVE_TRADING_ENABLED=false

# Broker connections (docs/broker-integration.md). Read-only connect/sync for INDstocks.
# The adapter is UNVERIFIED against the live API, so it is off by default. Orders stay locked.
BROKER_INDSTOCKS_ENABLED=false
# Product for F&O orders if live trading is ever enabled: INTRADAY or MARGIN.
BROKER_INDSTOCKS_PRODUCT=INTRADAY
# Fernet key that encrypts broker access tokens at rest. Required outside development/test
# when a broker integration is enabled. Changing it makes stored tokens unreadable (users
# reconnect). Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
BROKER_TOKEN_ENCRYPTION_KEY=

# Optional Telegram notifier (docs/reports.md). Disabled unless both are set. Sends only
# alert titles/levels and DEMO report summaries; REAL reports are announced without amounts.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# The chat is server-wide: only these users' daily reports are announced. Empty = nobody.
TELEGRAM_USER_EMAILS=

# Mobile (Expo). Only public, non-secret values may use the EXPO_PUBLIC_ prefix.
EXPO_PUBLIC_API_URL=http://localhost:8000
# Optional public support contact shown on Help & Support. Leave empty to show none.
EXPO_PUBLIC_SUPPORT_EMAIL=
